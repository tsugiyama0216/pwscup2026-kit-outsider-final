# 参加者がキットを動かすと出来るもの
**/.venv/
**/.ipynb_checkpoints/
**/__pycache__/
*.py[cod]
*.egg-info/

# ローカル実行用（setup-local.ps1 / run-practice.ps1 が作成）
/.tools/
/.uv-cache/
/work/
/local-output/
/prelim/workspace/.tools/
/prelim/workspace/.uv-cache/
/prelim/workspace/work/
/prelim/workspace/local-output/

# Live submission credentials remain local, even for private repository backups.
/submissions/**/token.txt
/submissions/**/*.zip
/prelim/workspace/submissions/**/token.txt
/prelim/workspace/submissions/**/*.zip
/prelim/anonymization/**/token.txt
/prelim/anonymization/**/*.zip
/main_round/**/token.txt
/main_round/**/*.zip
/main_round/**/local-output/
.env
.env.*
!.env.example

